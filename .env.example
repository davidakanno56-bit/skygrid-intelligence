# SkyGrid Intelligence | Environment Configuration Template
# Akanno Tech Labs • Production B2B SaaS Platform

# ==============================================================================
# FRONTEND CONFIGURATION (Vercel / Vite)
# ==============================================================================
# The public URL of the deployed Render FastAPI backend.
# In local development, leave blank or set to http://localhost:3000
# In production on Vercel, set to your Render service URL (e.g. https://skygrid-backend.onrender.com)
VITE_API_BASE_URL=https://skygrid-backend.onrender.com

# ==============================================================================
# BACKEND CONFIGURATION (Render / Local Server)
# ==============================================================================
HOST=0.0.0.0
PORT=3000

# PostgreSQL Connection (Render PostgreSQL, Neon, AWS RDS, Supabase)
# DATABASE_URL=postgresql://skygrid_user:password@render-postgres-host.render.com:5432/skygrid_db

# External Real-Time Aviation & Meteorology API Keys (Optional: fallback high-fidelity stream active if blank)
# AVIATIONSTACK_API_KEY=your_aviationstack_key
# WEATHERSTACK_API_KEY=your_weatherstack_key

# Ingestion Polling Interval & Cache TTL (seconds)
POLL_INTERVAL_SECONDS=60
CACHE_TTL_SECONDS=60

# Critical Dispatch Thresholds
CORRIDOR_RISK_THRESHOLD=25.0
FLIGHT_RISK_THRESHOLD=25.0
WINDSHEAR_THRESHOLD_KTS=15.0

# Enterprise Security & Outbound Webhook HMAC Secret
WEBHOOK_SIGNING_SECRET=skygrid_sec_8f99c27940e4ab91

# Commercial Billing & Settlement Gateways (Flutterwave, Paystack, Raenest, Grey)
PAYMENT_GATEWAY=flutterwave
# FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxx-X
# FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxx-X
# RAENEST_BENEFICIARY_NAME=Akanno Tech Labs Ltd
# RAENEST_USD_BANK_NAME=Lead Bank / Raenest Corp Banking
# RAENEST_USD_ROUTING=101000695
# RAENEST_USD_ACCOUNT=884920194821
# RAENEST_SWIFT_BIC=LEADUS33XXX
