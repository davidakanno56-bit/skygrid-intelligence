# SkyGrid Intelligence | Environment Configuration Template
# Akanno Tech Labs Limited • Prototype / Evaluation & Enterprise Architecture

# ==============================================================================
# FRONTEND CONFIGURATION (Vercel / Vite)
# ==============================================================================
# Public URL of the deployed Render FastAPI backend.
# In local development, leave blank or set to http://localhost:3000
# In production on Vercel, set to your Render service URL (e.g. https://skygrid-intelligence.onrender.com)
VITE_API_BASE_URL=https://skygrid-intelligence.onrender.com

# Optional Authorized CARTO Basemap API Key (https://www.carto.com/basemaps/apikey/index.html)
# Note: Browser-delivered map keys are visible to clients — restrict this key in CARTO to your
# authorized domain(s) (e.g. skygrid-intelligence.vercel.app) and monitor usage.
# When omitted, SkyGrid automatically uses the authorized keyless OpenFreeMap Dark basemap.
# VITE_CARTO_BASEMAP_KEY=

# ==============================================================================
# BACKEND CONFIGURATION (Render / Local Server)
# ==============================================================================
HOST=0.0.0.0
PORT=3000

# PostgreSQL Connection (Render PostgreSQL, Neon, AWS RDS, Supabase)
# DATABASE_URL=postgresql://skygrid_user:password@render-postgres-host.render.com:5432/skygrid_db

# Administrative Secret Required for Privileged Key Provisioning & System Config Mutations
# Leave blank to keep public key provisioning disabled.
# SKYGRID_ADMIN_SECRET=

# External Real-Time Aviation & Meteorology API Keys (Optional: Simulation Mode active if blank)
# AVIATIONSTACK_API_KEY=
# WEATHERSTACK_API_KEY=

# Ingestion Polling Interval & Cache TTL (seconds)
POLL_INTERVAL_SECONDS=60
CACHE_TTL_SECONDS=60

# Critical Dispatch Thresholds
CORRIDOR_RISK_THRESHOLD=25.0
FLIGHT_RISK_THRESHOLD=25.0
WINDSHEAR_THRESHOLD_KTS=15.0

# Outbound Webhook HMAC Secret
# WEBHOOK_SIGNING_SECRET=

# Commercial Payment Gateway (DISABLED by default until corporate merchant account is verified)
ENABLE_LIVE_BILLING=false
PAYMENT_GATEWAY=paystack
# PAYSTACK_PUBLIC_KEY=
# PAYSTACK_SECRET_KEY=
# FLUTTERWAVE_PUBLIC_KEY=
# FLUTTERWAVE_SECRET_KEY=
# FLUTTERWAVE_WEBHOOK_HASH=

# Corporate Settlement Details (Populate ONLY after verified corporate banking onboarding)
CORPORATE_BENEFICIARY_NAME=Akanno Tech Labs Limited
# CORPORATE_BANK_NAME=
# CORPORATE_ROUTING_NUMBER=
# CORPORATE_ACCOUNT_NUMBER=
# CORPORATE_SWIFT_BIC=
