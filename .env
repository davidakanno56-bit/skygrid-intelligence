# SkyGrid Intelligence | Enterprise Environment Configuration
# Akanno Tech Labs

HOST=0.0.0.0
PORT=3000

# PostgreSQL Connection (Uncomment and replace with your live Postgres URL, e.g. AWS RDS, Neon, Supabase, or local)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skygrid_intelligence

# Aviationstack Real-Time Flight Tracking API Key (Optional: system provides high-fidelity ADS-B stream if blank)
# AVIATIONSTACK_API_KEY=your_aviationstack_api_key_here

# Weatherstack Real-Time Aviation Meteorology API Key (Optional: system provides real-time windshear stream if blank)
# WEATHERSTACK_API_KEY=your_weatherstack_api_key_here

# Ingestion Polling Interval & Cache TTL (seconds)
POLL_INTERVAL_SECONDS=60
CACHE_TTL_SECONDS=60

# Critical Dispatch Thresholds
CORRIDOR_RISK_THRESHOLD=25.0
FLIGHT_RISK_THRESHOLD=25.0
WINDSHEAR_THRESHOLD_KTS=15.0

# Enterprise Webhook HMAC Secret
WEBHOOK_SIGNING_SECRET=skygrid_sec_8f99c27940e4ab91

